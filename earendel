#!/usr/bin/env bash
# Wrapper `earendel` — tudo isolado nesta pasta.
# Usa .venv local; nunca instala nada no sistema.
set -euo pipefail
# Resolve symlink (ex: ~/.local/bin/earendel -> pasta do projeto)
SRC="${BASH_SOURCE[0]}"
while [[ -L "$SRC" ]]; do
  LINK="$(readlink "$SRC")"
  [[ "$LINK" != /* ]] && SRC="$(dirname "$SRC")/$LINK" || SRC="$LINK"
done
ROOT="$(cd "$(dirname "$SRC")" && pwd)"
# Recompõe ambiente gráfico (service pode subir antes da sessão exportar).
# Busca no user manager, que o Plasma atualiza no login.
for _v in DISPLAY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP XAUTHORITY; do
  if [[ -z "${!_v:-}" ]]; then
    _val="$(systemctl --user show-environment 2>/dev/null | grep -E "^${_v}=" | cut -d= -f2- || true)"
    [[ -n "${_val:-}" ]] && export "$_v=$_val"
  fi
done
unset _v _val
PY="$ROOT/.venv/bin/python"
if [[ ! -x "$PY" ]]; then
  echo "[earendel] venv não encontrado em $ROOT/.venv" >&2
  echo "[earendel] rode: ./scripts/install.sh  (só cria arquivos DENTRO desta pasta)" >&2
  exit 1
fi
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export EARENDEL_CONFIG="${EARENDEL_CONFIG:-$ROOT/config.json}"
export EARENDEL_MODELS="${EARENDEL_MODELS:-$ROOT/models}"
exec "$PY" -u -m earendel "$@"
